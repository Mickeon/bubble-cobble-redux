{
    "compilerOptions": {
        "lib": [
            "ES5",
            "ES2015"
        ],
        "rootDirs": [
            "probe/generated",
            "probe/user",
            "server_scripts",
            "startup_scripts",
            "client_scripts"
        ],
        "target": "ES2015"
    },
    "include": [
        "../.probe/@package/**/*.d.ts",
        "../.probe/@side-only/client/**/*.d.ts",
        "../.probe/@side-only/server/**/*.d.ts",
        "../.probe/@side-only/startup/**/*.d.ts",
        "../.probe/@special/**/*.d.ts"
    ]
}