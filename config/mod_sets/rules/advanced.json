{
  "$schema": "https://raw.githubusercontent.com/SettingDust/ModSets/main/rules.schema.json",
  "text": {"text": "My Ding-A-Ling","bold": true,"color": "dark_green"},
  "rules": [
    {
      "text": "Development",
      "description": ["Utilities tailored to the ",{"color":"#76deea","text":"development"}," of ",{"bold":true,"text":"Bubble Cobble"},".\nThey offer useful insight, but may have a notable performance impact.\n\nThese are normally not exported to the modpack. If unsure, ",{"italic":true,"text":"don't worry"},"."],
      "controller": {
        "type": "boolean",
        "id": "development_set"
      }
    },
    {
      "text": "🗺 Map",
      "description": ["",{"color":"blue","text":"Xaero's Map","clickEvent":{"action":"open_url","value":"https://modrinth.com/mod/xaeros-world-map"}},", Minimap, and anything to do with it.\n\nDisable if the ",{"color":"dark_aqua","text":"CPU"}," cannot keep up, although I ",{"italic":true,"text":"seriously"}," doubt you'd want to, as ",{"color":"dark_aqua","text":"you won't be able to join the modpack's server"},"!"],
      "controller": {
        "type": "boolean",
        "id": "xaero_map_set"
      }
    },
    {
      "text": {"text": "⚠ Danger Zone ⚠", "color": "red", "bold": true},
      "description": "That sign can't stop me, 'cause I can't read.",
      "controller": {
        "type": "rules_group",
        "collapsed": true,
        "rules": [
          {
            "text": "KubeJS",
            "description": "Mods focused purely on enshittifying the game.",
            "controller": {
              "type": "boolean",
              "id": "danger_kubejs_set"
            }
          },
          {
            "text": "Optimization",
            "description": "Mods focused purely on optimizing the game.",
            "controller": {
              "type": "mods_group",
              "ids": [
                "modernfix",
                "entityculling",
                "particle_core",
                "saturn",
                "immediatelyfast",
                "ferritecore",
                "sodium",
                "lithium",
                "asyncparticles",
                "achiopt"
              ]
            }
          },
          {
            "text": "Sophisticated Storage",
            "description": "Mods focused purely on optimizing the chests in the game.",
            "controller": {
              "type": "mods_group",
              "ids": [
                "sophisticatedbackpacks",
                "sophisticatedcore",
                "sophisticatedfix",
                "sophisticatedstorage",
                "sophisticateditemactions",
                "sophisticatedsorter"
              ]
            }
          },
          {
            "text": "Create",
            "description": "Mods focused purely on optimizing the fun out of the game.",
            "controller": {
              "type": "mods_group",
              "ids": [
                "create",
                "createdeco",
                "create_deepfried",
                "create_bic_bit",
                "create_ltab",
