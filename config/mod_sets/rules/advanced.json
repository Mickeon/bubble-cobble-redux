              ]
            }
          },
          {
            "text": "Cobblemon",
            "description": "Mods focused purely on playing a different game.",
            "controller": {
              "type": "mods_group",
              "ids": [
                "cobblemon",
                "cobblemonraiddens",
                "cobblemonintegrations",
                "capture_xp",
                "tim_core",
                "rctmod",
                "rctapi",
