            }
          },
          {
            "text": "Compatibility",
            "description": "Mods focused purely on integrating the mods in the game.",
            "controller": {
              "type": "mods_group",
              "ids": [
                "sophisticatedbackpackscreateintegration",
                "sophisticatedstoragecreateintegration",
                "cobblemonintegrations",
